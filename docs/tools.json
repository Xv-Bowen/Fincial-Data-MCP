[
  {
    "name": "finance_exchange_rates",
    "title": "查询参考汇率",
    "description": "通过 Frankfurter 查询欧洲央行来源的最新或指定日期参考汇率，无需厂商 API Key。返回实际日期和兑换方向；这是日度参考价，非实时交易价。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "base": {
          "type": "string",
          "pattern": "^[A-Za-z]{3}$",
          "default": "USD"
        },
        "quotes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z]{3}$"
          },
          "minItems": 1,
          "maxItems": 10,
          "default": [
            "CNY",
            "EUR"
          ]
        },
        "date": {
          "type": "string",
          "format": "date"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true
    }
  },
  {
    "name": "finance_macro_indicator",
    "title": "查询年度宏观指标",
    "description": "查询世界银行 WDI 年度指标：GDP、GDP 增速、人均 GDP、消费物价增速、ILO 模型失业率或总人口。国家用 CHN、USA 等代码。保留单位、统计年份、修订日期与缺失值，不提供预测。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "country": {
          "type": "string",
          "pattern": "^[A-Za-z]{2,3}$"
        },
        "indicator": {
          "type": "string",
          "enum": [
            "NY.GDP.MKTP.CD",
            "NY.GDP.MKTP.KD.ZG",
            "NY.GDP.PCAP.CD",
            "FP.CPI.TOTL.ZG",
            "SL.UEM.TOTL.ZS",
            "SP.POP.TOTL"
          ]
        },
        "start_year": {
          "type": "integer",
          "minimum": 1960,
          "maximum": 2100
        },
        "end_year": {
          "type": "integer",
          "minimum": 1960,
          "maximum": 2100
        }
      },
      "required": [
        "country",
        "indicator",
        "start_year",
        "end_year"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true
    }
  },
  {
    "name": "finance_sources_status",
    "title": "查看数据来源",
    "description": "查看腾讯、新浪及接口适配的配置状态，单列已停用的 efinance 日线路径和待接通的 BaoStock。也包含宏观与汇率来源；配置不代表实时可用。",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true
    }
  },
  {
    "name": "finance_multi_source_history",
    "title": "多来源历史行情",
    "description": "按指定来源查询同一沪深 A 股的日线。返回每个来源的实际状态、底层数据源、日期、复权口径与原始数据。不复权默认腾讯与新浪，复权默认腾讯；未接通来源不进入默认查询。来源失败时保留状态，不编造补齐。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "symbol": {
          "type": "string"
        },
        "start_date": {
          "type": "string",
          "format": "date"
        },
        "end_date": {
          "type": "string",
          "format": "date"
        },
        "adjust": {
          "type": "string",
          "enum": [
            "none",
            "qfq",
            "hfq"
          ],
          "default": "none"
        },
        "providers": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "tencent",
              "sina",
              "akshare",
              "ashare",
              "baostock"
            ]
          },
          "minItems": 1,
          "maxItems": 5
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500,
          "default": 100
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        }
      },
      "required": [
        "symbol",
        "start_date",
        "end_date"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true
    }
  },
